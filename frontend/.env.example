# Vite dev-server / build env for the Site-Selection SPA (GEO-22).
#
# The root `.env` is consumed by docker compose (env_file), NOT by `vite dev`/`vite build`.
# Vite only reads `import.meta.env.VITE_*` from frontend-local .env files. Copy this to
# `frontend/.env` or `frontend/.env.local` for local development.
#
# Build-time injection of these from the root .env (MAPBOX_TOKEN -> VITE_MAPBOX_TOKEN via
# a Docker build-arg) is GEO-33; see the commented `args:` block in docker-compose.yml.

# Base URL the SPA calls for the API. Behind nginx this is the relative "/api" (GEO-34).
VITE_API_BASE_URL=/api

# Mapbox access token for basemap tiles. If empty, the app falls back to a free,
# token-less data-muted basemap (CARTO Positron / Dark Matter) so the map still renders.
VITE_MAPBOX_TOKEN=

# URL of the parcels PMTiles archive (served over HTTP byte-range requests).
# GEO-14 produces the real .pmtiles; until then this may 404 (the map degrades to the
# basemap only). Served by nginx from the data volume (GEO-34).
VITE_PARCELS_PMTILES_URL=/data/current/parcels.pmtiles
