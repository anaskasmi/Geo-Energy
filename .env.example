# Site-Selection App — environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored and excluded from build images (.dockerignore). NEVER commit it.
# Compose injects these into the services via `env_file: [.env]`.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Anthropic API key — used by the agent loop in `api` (GEO-21).
ANTHROPIC_API_KEY=

# NREL API key — used by ingest fetchers for solar/GHI data (developer.nrel.gov).
NREL_API_KEY=

# Mapbox access token — basemap tiles in the SPA. Injected at frontend BUILD time
# (VITE_MAPBOX_TOKEN, GEO-33); kept here so a single .env drives every service.
MAPBOX_TOKEN=

# ── Build-time frontend config (Vite) ────────────────────────────────────────
# Base URL the SPA calls for the API. Behind nginx this is the relative "/api".
VITE_API_BASE_URL=/api

# ── Runtime knobs (sane defaults; override as needed) ─────────────────────────
# Where the shared artifact lives inside every container (matches the data: mount).
DATA_DIR=/data
# Anthropic model selection for the agent (GEO-21).
ANTHROPIC_MODEL=claude-opus-4-8
# Log level for the ingest pipeline (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO
# Number of past release builds to retain on the data volume before pruning (min 1).
KEEP_RELEASES=3
# DuckDB worker threads for the ingest build. Leave unset/blank to autodetect CPU count.
# DUCKDB_THREADS=
