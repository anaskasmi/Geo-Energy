# Site-Selection App — environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored and excluded from build images (.dockerignore). NEVER commit it.
# Compose injects these into the services via `env_file: [.env]`.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Google Gemini Developer API key — used by the GEO-21 agent (Pydantic AI, `google:` model
# prefix). SECRET. Leave blank to disable the agent path. NEVER commit a real value.
GOOGLE_API_KEY=

# Anthropic API key — kept for a one-flip provider switch-back (set AGENT_MODEL to an
# `anthropic:` model). SECRET; blank by default now that the agent defaults to Gemini (GEO-21).
ANTHROPIC_API_KEY=

# NREL API key — used by ingest fetchers for solar/GHI data (developer.nrel.gov).
NREL_API_KEY=

# OpenAI API key — powers the assistant's VOICE mode (GEO-40, OpenAI Realtime over WebRTC). SECRET.
# Used ONLY server-side to mint short-lived browser session secrets; it never reaches the client and
# is never logged. Leave blank to disable voice mode (the mic button shows a tidy disabled state).
OPENAI_API_KEY=
# Realtime model + voice (override if the default model id changes upstream). Voices: marin, cedar,
# alloy, coral, … See platform.openai.com/docs/guides/realtime.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Land-affordability check (GEO-41) — the agent's `check_affordability` tool, the ONE request-path
# outbound call. Both are FREE and globally reachable. SECRET; never logged.
#   FRED_API_KEY   : St. Louis Fed (FHFA Kern HPI price trend). Required for the trend signal —
#                    free instant key at fredaccount.stlouisfed.org/apikeys. Blank → trend omitted.
#   CENSUS_API_KEY : US Census (ACS median home value). Optional — works keyless at low volume; a
#                    key (api.census.gov/data/key_signup.html) lifts the rate limit.
# Leave both blank to disable the affordability tool (it returns a clean "unavailable" message).
FRED_API_KEY=
CENSUS_API_KEY=
# Census ACS 5-year vintage to query (falls back to the prior year automatically).
CENSUS_ACS_YEAR=2023

# Mapbox access token — basemap tiles in the SPA. Injected at frontend BUILD time
# (VITE_MAPBOX_TOKEN, GEO-33); kept here so a single .env drives every service.
MAPBOX_TOKEN=

# ── Build-time frontend config (Vite) ────────────────────────────────────────
# Base URL the SPA calls for the API. Behind nginx this is the relative "/api".
VITE_API_BASE_URL=/api

# ── Runtime knobs (sane defaults; override as needed) ─────────────────────────
# Where the shared artifact lives inside every container (matches the data: mount).
DATA_DIR=/data
# Agent model — provider:model string Pydantic AI resolves (GEO-21). Default is Gemini Flash;
# flip to `anthropic:claude-opus-4-8` (and set ANTHROPIC_API_KEY) to switch providers, no code
# change. Re-verify live Gemini model IDs at ai.google.dev/gemini-api/docs/models before pinning.
AGENT_MODEL=google:gemini-3.5-flash

# Agent safety caps (GEO-37). The API owns the authoritative defaults; these are documented here
# so an operator can tune them, and they mirror the nginx /api/agent rate/size limits (GEO-37).
# AGENT_TIMEOUT_S        : server-side abort for a single agent run (google-genai streaming has
#                          no clean transport-close handle, so a hard timeout is required). Keep it
#                          BELOW the nginx /api/agent `proxy_read_timeout 300s` so the app aborts
#                          first and emits a clean SSE `error` event (matches the API default).
AGENT_TIMEOUT_S=60
# AGENT_MAX_MESSAGE_CHARS : reject oversized chat messages before they reach the LLM (paired with
#                           nginx `client_max_body_size 256k` on /api/agent; matches API default).
AGENT_MAX_MESSAGE_CHARS=4000
# AGENT_MAX_CONCURRENCY   : in-flight agent runs allowed process-wide (protects the metered key
#                           and the 1g/2cpu api container; paired with nginx limit_conn).
AGENT_MAX_CONCURRENCY=4

# Log level for the ingest pipeline (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO
# Number of past release builds to retain on the data volume before pruning (min 1).
KEEP_RELEASES=3
# DuckDB worker threads for the ingest build. Leave unset/blank to autodetect CPU count.
# DUCKDB_THREADS=
